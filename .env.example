# =================================================================
# SIH26091 - Environment Configuration Template
# PRODUCTION TARGET: Supabase (DB) + Render (Backend) + Vercel (Frontend)
# NOTE: DO NOT COMMIT REAL SECRETS OR VALUES TO VERSION CONTROL
# =================================================================

# -----------------------------------------------------------------
# 1. BACKEND SERVICE SETTINGS (Render)
# -----------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
LOG_LEVEL=INFO

# -----------------------------------------------------------------
# 2. CORS & FRONTEND CLIENT CONNECTIVITY
# -----------------------------------------------------------------
# Set FRONTEND_URL to your Vercel deployment domain
FRONTEND_URL=https://your-sih26091-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-sih26091-app.vercel.app

# -----------------------------------------------------------------
# 3. SUPABASE POSTGRESQL + POSTGIS DATABASE
# -----------------------------------------------------------------
# Format: postgresql+psycopg2://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# -----------------------------------------------------------------
# 4. GOOGLE GEMINI AI API (Advisory, Embeddings & LangChain Agent)
# -----------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# -----------------------------------------------------------------
# 5. OPEN GOVERNMENT DATA (data.gov.in)
# -----------------------------------------------------------------
DATA_GOV_IN_API_KEY=
CENSUS_API_URL=https://api.data.gov.in/resource/census-pca

# -----------------------------------------------------------------
# 6. MSME UDYAM REGISTRY OPEN DATA
# -----------------------------------------------------------------
UDYAM_API_KEY=
UDYAM_API_URL=https://api.data.gov.in/resource/msme-udyam

# -----------------------------------------------------------------
# 7. OPENSTREETMAP & SPATIAL POI SERVICES
# -----------------------------------------------------------------
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
NOMINATIM_GEOCODE_URL=https://nominatim.openstreetmap.org/search
GEOCODING_USER_AGENT=SIH26091-Rural-Business-Advisory/1.0
EXTERNAL_API_TIMEOUT_SECONDS=6.0
EXTERNAL_API_MAX_RETRIES=2
EXTERNAL_API_BACKOFF_FACTOR=0.5

# -----------------------------------------------------------------
# 8. FRONTEND CLIENT CONFIGURATION (Vercel)
# -----------------------------------------------------------------
# Set this in Vercel environment variables to point to Render backend
VITE_API_BASE_URL=https://sih26091-backend.onrender.com
