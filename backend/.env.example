PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
FRONTEND_URL=https://your-sih26091-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
LOG_LEVEL=INFO

# PostgreSQL + PostGIS Configuration (Local or Supabase)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sih26091_advisory
# Supabase Pooler Example:
# DATABASE_URL=postgresql+psycopg2://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# AI Agent Configuration (Google Gemini) - NEVER stored in DB
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Spatial & OpenStreetMap Settings
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
NOMINATIM_GEOCODE_URL=https://nominatim.openstreetmap.org/search
GEOCODING_USER_AGENT=SIH26091-Rural-Business-Advisory/1.0

# Census & UDYAM Open Data API Credentials (data.gov.in)
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here
CENSUS_API_URL=https://api.data.gov.in/resource/census-pca
UDYAM_API_KEY=your_udyam_api_key_here
UDYAM_API_URL=https://api.data.gov.in/resource/msme-udyam
EXTERNAL_API_TIMEOUT_SECONDS=6.0

